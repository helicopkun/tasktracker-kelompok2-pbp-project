{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["public/**"] }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/script/(.*)", "dest": "/public/script/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "index.js" }
  ],

  "regions": ["sin1"]

}
